{
  "manifest_version": 3,
  "name": "T3 Code 简体中文汉化",
  "short_name": "T3 中文",
  "version": "1.1.2",
  "description": "T3 Code Web UI 全量简体中文汉化，自动识别 T3 Code 页面与 Web 版本。",
  "author": "NotoChen",
  "homepage_url": "https://github.com/NotoChen/t3-code-zh",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "T3 Code 简体中文汉化",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://app.t3.codes/*"
      ],
      "js": [
        "translations.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}