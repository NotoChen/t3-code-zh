{
  "manifest_version": 3,
  "name": "T3 Code 简体中文汉化",
  "version": "1.1.0",
  "description": "T3 Code Web UI 全量简体中文汉化，自动识别 T3 Code 页面与 Web 版本。",
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://app.t3.codes/*"
      ],
      "js": [
        "translations.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}